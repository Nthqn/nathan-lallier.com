---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, poste, description as descriptionSite } from '../data/site';
import { alternates, langFromPath, ui, LOCALE, route } from '../i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const lang = langFromPath(Astro.url.pathname);
const t = ui(lang);
const { title, description = descriptionSite(lang), image = '/icon-512.png', type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = title === SITE.nom ? `${SITE.nom} | ${poste(lang)}` : `${title} | ${SITE.nom}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const alt = alternates(Astro.url.pathname);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alt && (
      <>
        <link rel="alternate" hreflang="fr" href={new URL(alt.fr, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(alt.fr, Astro.site)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6eedc" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preload" href="/fonts/abril-fatface-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/opensans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={LOCALE[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Thème et classe js appliqués avant l'affichage, pour éviter un flash -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try { if (localStorage.getItem('theme') === 'dark') root.classList.add('dark-mode'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#contenu" class="skip-link">{t.skip}</a>
    <Header lang={lang} alt={alt} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <div class="cookie-banner" id="cookie-banner" role="dialog" aria-label={t.cookiesLabel} hidden>
      <p><Fragment set:html={t.cookiesTexte} /> <a href={route('politique', lang)}>{t.cookiesPlus}</a></p>
      <div class="actions">
        <button type="button" class="btn btn-secondary btn-small" data-consent="refused">{t.refuser}</button>
        <button type="button" class="btn btn-primary btn-small" data-consent="accepted">{t.accepter}</button>
      </div>
    </div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

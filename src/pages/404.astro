---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" noindex>
  <div class="container page introuvable">
    <p class="code-erreur" aria-hidden="true">404</p>
    <h1 class="title-lg">Cette page <span class="highlight">n'existe pas</span></h1>
    <p class="lead">L'adresse a peut-être changé avec la nouvelle version du site. Les procédures, par exemple, se lisent maintenant directement en ligne.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <a href="/procedures" class="btn btn-secondary">Voir les procédures</a>
    </div>
    <p class="muted" lang="en">This page does not exist. <a href="/en" class="link-more">Go to the English homepage →</a></p>
  </div>
</Base>
<style>
  .introuvable { justify-items: center; text-align: center; gap: 20px; padding-block: 80px 110px; }
  .code-erreur { font-family: var(--font-display); font-size: clamp(5rem, 16vw, 9rem); line-height: 1; color: var(--accent); }
  .introuvable .lead { margin-inline: auto; }
  .introuvable .actions { justify-content: center; }
</style>

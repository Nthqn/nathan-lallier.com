---
// Dessin au trait affiché en haut des cartes de projet. Le trait suit --teal-text, l'élément clé suit l'orange.
interface Props { motif?: string; lang?: 'fr' | 'en' }
const { motif = 'reseau', lang = 'fr' } = Astro.props;
---
<svg class="illu" viewBox="0 0 360 130" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {motif === 'multisite' && (
    <>
      {[0, 1].map((i) => {
        const x = i === 0 ? 34 : 256;
        const fw = i === 0 ? 118 : 216;
        return (
          <g>
            <rect class="fond" x={x} y="34" width="70" height="78" rx="4" />
            <rect class="trait" x={x} y="34" width="70" height="78" rx="4" />
            {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <rect class="trait fin" x={x + 12 + c * 18} y={46 + r * 18} width="10" height="9" rx="1.5" />))}
            <path class="trait" d={`M${x + 28} 112v-12h14v12`} />
            <rect class="fond" x={fw} y="58" width="26" height="24" rx="3" />
            <rect class="trait" x={fw} y="58" width="26" height="24" rx="3" />
            <path class="trait fin" d={`M${fw} 66h26M${fw} 74h26M${fw + 13} 58v8M${fw + 7} 66v8M${fw + 19} 66v8M${fw + 13} 74v8`} />
            <path class="trait" d={i === 0 ? `M${x + 70} 70h14` : `M${fw + 26} 70h14`} />
            <text class="etiquette" x={x + 35} y="126" text-anchor="middle">SITE {i + 1}</text>
          </g>
        );
      })}
      <path class="cle tirets" d="M144 70h72" />
      <rect class="cle-fond" x="170" y="62" width="20" height="16" rx="3" />
      <rect class="cle" x="170" y="62" width="20" height="16" rx="3" />
      <path class="cle" d="M174 62v-5a6 6 0 0 1 12 0v5" />
      <text class="etiquette cle-texte" x="180" y="98" text-anchor="middle">IPSEC</text>
    </>
  )}
  {motif === 'migration' && (
    <>
      <rect class="fond" x="46" y="26" width="64" height="86" rx="4" />
      <rect class="trait" x="46" y="26" width="64" height="86" rx="4" />
      {[0, 1, 2, 3].map((u) => (
        <g>
          <rect class="trait fin" x="54" y={34 + u * 19} width="48" height="13" rx="2" />
          <circle class="point" cx="61" cy={40.5 + u * 19} r="2" />
          <path class="trait fin" d={`M70 ${40.5 + u * 19}h24`} />
        </g>
      ))}
      <text class="etiquette" x="78" y="126" text-anchor="middle">{lang === 'en' ? 'ON-PREM' : 'SUR SITE'}</text>
      <path class="cle tirets" d="M122 72c30-26 64-26 92-6" />
      <path class="cle" d="M206 58l9 8-11 4" />
      <rect class="cle-fond" x="146" y="54" width="9" height="9" rx="2" />
      <rect class="cle" x="146" y="54" width="9" height="9" rx="2" />
      <rect class="cle-fond" x="176" y="48" width="9" height="9" rx="2" />
      <rect class="cle" x="176" y="48" width="9" height="9" rx="2" />
      <path class="fond" d="M240 104h66a24 24 0 0 0 2-48 32 32 0 0 0-61-6 25 25 0 0 0-7 54z" />
      <path class="trait" d="M240 104h66a24 24 0 0 0 2-48 32 32 0 0 0-61-6 25 25 0 0 0-7 54z" />
      {[0, 1, 2].map((c) => <rect class="trait fin" x={250 + c * 22} y="72" width="16" height="16" rx="2.5" />)}
      <text class="etiquette" x="276" y="126" text-anchor="middle">AZURE</text>
    </>
  )}
  {motif === 'reseau' && (
    <>
      {[[90, 40], [180, 25], [270, 45], [130, 95], [235, 100]].map(([x, y]) => <circle class="trait" cx={x} cy={y} r="9" />)}
      <path class="trait fin" d="M99 42l72-15M189 27l72 16M96 47l28 41M139 95l87 5M265 53l-24 39M180 34l-46 53" />
    </>
  )}
</svg>
<style>
  .illu { width: min(100%, 360px); height: auto; max-height: 100%; }
  .trait { stroke: var(--teal-text); stroke-width: 2.2; }
  .fin { stroke-width: 1.6; opacity: 0.75; }
  .fond { fill: var(--teal); opacity: 0.12; stroke: none; }
  .point { fill: var(--teal); stroke: none; }
  .cle { stroke: var(--accent); stroke-width: 2.4; }
  .cle-fond { fill: var(--teal-soft); stroke: none; }
  .tirets { stroke-dasharray: 6 6; }
  .etiquette { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; fill: var(--text-muted); stroke: none; }
  .cle-texte { fill: var(--accent-text); }
</style>

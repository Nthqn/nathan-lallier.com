---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.webp';
import Icon from './Icons.astro';
import { SITE } from '../data/site';
import { route, ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const [avant, accent, apres] = t.footerTitre;
---
<footer class="site-footer">
  <div class="container">
    <div>
      <p class="footer-title">{avant} <span class="highlight">{accent}</span> {apres}</p>
      <div class="socials">
        <a href={`mailto:${SITE.email}`} aria-label={t.email}><Icon name="mail" /></a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
      </div>
    </div>
    <div class="footer-center">
      <Image src={logo} alt="" width={56} height={56} />
      <p>© {new Date().getFullYear()} <strong>{SITE.nom}</strong></p>
    </div>
    <nav class="footer-links" aria-label={t.legalLabel}>
      <a href={route('mentions', lang)}>{t.mentions}</a>
      <a href={route('politique', lang)}>{t.politique}</a>
      <a href={route('accessibilite', lang)}>{t.accessibilite}</a>
      <button type="button" data-cookie-reopen>{t.cookiesGerer}</button>
    </nav>
  </div>
</footer>
